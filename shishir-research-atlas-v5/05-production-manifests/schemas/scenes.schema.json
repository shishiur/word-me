{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "scenes",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "project",
      "title",
      "question",
      "purpose",
      "states",
      "evidence",
      "implementation",
      "visualFidelity"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^P0[1-8]-S\\d{2}$"
      },
      "project": {
        "type": "string",
        "pattern": "^P0[1-8]$"
      },
      "title": {
        "type": "string"
      },
      "question": {
        "type": "string"
      },
      "purpose": {
        "type": "string"
      },
      "states": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      },
      "evidence": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^(P0[1-8]-E\\d{3}|REF-\\d{3})$"
        }
      },
      "implementation": {
        "enum": [
          "implemented-tested",
          "implemented-untested",
          "specification",
          "blocked-permission"
        ]
      },
      "visualFidelity": {
        "enum": [
          "generated-final",
          "vector-final",
          "vector-fallback",
          "vector-concept",
          "none"
        ]
      }
    }
  }
}
