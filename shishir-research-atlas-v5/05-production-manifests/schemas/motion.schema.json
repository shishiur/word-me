{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "motion",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "scene",
      "name",
      "trigger",
      "runtime",
      "keyframes",
      "duration",
      "ease",
      "interrupt",
      "reduced"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^P0[1-8]-S\\d{2}-M\\d{3}$"
      },
      "runtime": {
        "enum": [
          "gsap",
          "gsap.quickTo",
          "gsap+scrolltrigger",
          "remotion"
        ]
      }
    }
  }
}
