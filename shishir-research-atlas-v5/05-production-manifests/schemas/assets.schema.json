{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "assets",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "layer",
      "file",
      "tool",
      "status",
      "fallback"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^P0[1-8]-S\\d{2}-A\\d{3}$"
      },
      "layer": {
        "enum": [
          "background",
          "floor",
          "light",
          "object",
          "atmosphere"
        ]
      },
      "tool": {
        "enum": [
          "image-generation",
          "code",
          "researcher-supplied"
        ]
      },
      "status": {
        "enum": [
          "awaiting-generation",
          "generated-unreviewed",
          "generated-approved",
          "vector-final",
          "missing",
          "optional"
        ]
      },
      "file": {
        "type": "string",
        "pattern": "^p0[1-8]-s\\d{2}-a\\d{3}-[a-z0-9-]+\\.(webp|png|svg|jpg)$"
      },
      "depth": {
        "type": "number"
      },
      "z": {
        "type": "number"
      },
      "size": {
        "type": [
          "array",
          "null"
        ]
      },
      "position": {
        "type": "array"
      },
      "pivot": {
        "type": "array"
      },
      "prompt": {
        "type": [
          "object",
          "null"
        ],
        "required": [
          "subject",
          "structure",
          "count",
          "camera",
          "framing",
          "scale",
          "materials",
          "lighting",
          "palette",
          "treatment",
          "background",
          "transparency",
          "aspect",
          "references",
          "negative",
          "consistency",
          "animation"
        ]
      }
    }
  }
}
